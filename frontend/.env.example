# Copiar a .env.local (no se sube al repo) y ajustar según el entorno.

# "mock": login instantáneo sin IdP real (default si se omite esta variable) — para desarrollar sin
#         depender de que Cognito/Entra ID ya existan.
# "oidc": Authorization Code + PKCE real contra Cognito y Entra ID.
VITE_AUTH_MODE=mock

# Si es "false", desactiva MSW y las llamadas van directo a VITE_API_BASE_URL (backend real).
# Por defecto (ausente o cualquier otro valor) los datos los sirve el mock local (src/mocks).
VITE_USE_MOCKS=true

# URL del API Gateway. Solo importa cuando VITE_USE_MOCKS=false.
VITE_API_BASE_URL=http://localhost:8080

# Requeridas solo cuando VITE_AUTH_MODE=oidc.
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_ENTRA_AUTHORITY=
VITE_ENTRA_CLIENT_ID=
